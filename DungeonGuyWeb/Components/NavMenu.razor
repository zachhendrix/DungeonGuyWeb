<MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Mini" Anchor="Anchor.Top" Class="mud-drawer-custom">
    <MudDrawerHeader Class="mud-drawer-header-custom">
        <MudTooltip Placement="Placement.Right" Text="@(_open ? "Close Menu" : "Open Menu")">
            <MudIconButton Icon="@(_open ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                           OnClick="@_toggleDrawer"
                           Class="mud-icon-button-custom" />
        </MudTooltip>
    </MudDrawerHeader>

    <MudNavMenu>

    </MudNavMenu>
</MudDrawer>

@code{
    private bool _open = false;

    private void _toggleDrawer()
    {
        _open = !_open;
    }

}