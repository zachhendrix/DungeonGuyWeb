<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   Edge="Edge.Start"
                   OnClick="@ToggleDrawer" />
    <MudSpacer />
    <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                   Color="Color.Inherit"
                   Href="https://github.com/MudBlazor/MudBlazor"
                   Target="_blank" />
</MudAppBar>

<MudDrawer @bind-Open="Open" Elevation="1">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Main Menu</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudNavLink Match="NavLinkMatch.All" Href="/">Character</MudNavLink>
        <MudNavLink Match="NavLinkMatch.All" Href="/inventory">Inventory</MudNavLink>
        <MudNavLink Match="NavLinkMatch.All" Href="/map">Map</MudNavLink>
    </MudNavMenu>
</MudDrawer>
