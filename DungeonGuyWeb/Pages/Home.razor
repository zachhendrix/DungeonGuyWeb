@page "/"
@using MudBlazor
@using Data.Character

<MudGrid>

    <MudItem xs="6">
        <MudPaper Elevation="0">
            
            <MudText>Enter your name:</MudText>
            <MudTextField T="string" 
                @bind-Value="Name" 
                Required="true"
                Variant="Variant.Outlined"
                MaxLength="20" 
                Label="Enter your name" 
                HelperText="@($"{(Name?.Length ?? 0)}/20 characters used")" />
            
            <MudText>What kind of being are you?</MudText>
            <MudSelect T="Race" @bind-Value="selectedRace" Required="true" Variant="Variant.Outlined" Class="selectbox">
                @foreach (Race race in Enum.GetValues<Race>())
                {
                    <MudSelectItem T="Race" Value="@race">@race</MudSelectItem>
                }
            </MudSelect>
            <MudText>What do you specialize in?</MudText>
            <MudSelect T="Job" @bind-Value="selectedJob" Required="true" Variant="Variant.Outlined" Class="selectbox">
                @foreach (Job job in Enum.GetValues<Job>())
                {
                    <MudSelectItem T="Job" Value="@job">@job</MudSelectItem>
                }
            </MudSelect>
        </MudPaper>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(Name))">Create Character</MudButton>
    </MudItem>

    <MudItem xs="6">

    </MudItem>

</MudGrid>

@code {
    string? Name { get; set; }
    Race selectedRace { get; set; }
    Job selectedJob { get; set; }



}